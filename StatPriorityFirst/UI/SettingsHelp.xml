<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!--
		Wrapped body text for Blizzard's vertical Settings list.
		Height comes from the initializer's GetExtent (see Settings.lua).
	-->
	<Frame name="StatPriorityFirstSettingsDescriptionTemplate" virtual="true" mixin="StatPriorityFirstSettingsDescriptionMixin">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-4"/>
						<Anchor point="BOTTOMRIGHT" x="-26" y="4"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
